rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------- Helper Primitives ----------------

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 2 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isEmailVerified() && (
        request.auth.token.email == 'new.gov.iq@gmail.com' ||
        request.auth.token.email == 's3nabarqe@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProtectionLevel(level) {
      return level in ['semi-protected', 'strict-review', 'open'];
    }

    function isValidArticleType(articleType) {
      return articleType in ['person', 'place', 'general'];
    }

    function isValidPortal(portal) {
      return portal in [
        'شخصيات وأعلام',
        'عشائر وأنساب',
        'فنون وثقافة',
        'أماكن ومدن',
        'أحداث تاريخية',
        'إعلام وسياسة'
      ];
    }

    function isValidAccentTone(tone) {
      return tone in ['lapis', 'bronze', 'forest', 'terracotta'];
    }

    function isValidBoundedStringList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || arr[0] is string);
    }

    function isValidBoundedMapList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || arr[0] is map);
    }

    // ---------------- Entity Validation Blueprints ----------------

    function isValidProposedSnapshot(data) {
      return data is map
        && data.keys().hasAll([
          'name', 'subtitle', 'portal', 'summary', 'field',
          'activeYears', 'birthDeath', 'birthplace', 'notableWorks',
          'categories', 'sections', 'references'
        ])
        && data.keys().hasOnly([
          'name', 'subtitle', 'portal', 'articleType', 'summary', 'field',
          'activeYears', 'birthDate', 'deathDate', 'birthDeath', 'birthplace',
          'clanAffiliation', 'geographicLocation', 'administrativeRegion',
          'coordinates', 'populationEstimate', 'relatedClans', 'historicalEra',
          'notableWorks', 'infoboxRows', 'imageUrl', 'imageCaption',
          'categories', 'subcategories', 'isStub', 'needsSources', 'isFeatured', 'sections', 'references'
        ])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 200
        && data.subtitle is string && data.subtitle.size() <= 300
        && isValidPortal(data.portal)
        && (!('articleType' in data) || isValidArticleType(data.articleType))
        && data.summary is string && data.summary.size() >= 5 && data.summary.size() <= 8000
        && data.field is string && data.field.size() >= 2 && data.field.size() <= 200
        && data.activeYears is string && data.activeYears.size() <= 160
        && (!('birthDate' in data) || (data.birthDate is string && data.birthDate.size() <= 80))
        && (!('deathDate' in data) || (data.deathDate is string && data.deathDate.size() <= 80))
        && data.birthDeath is string && data.birthDeath.size() <= 160
        && data.birthplace is string && data.birthplace.size() <= 240
        && (!('clanAffiliation' in data) || (data.clanAffiliation is string && data.clanAffiliation.size() <= 160))
        && (!('geographicLocation' in data) || (data.geographicLocation is string && data.geographicLocation.size() <= 300))
        && (!('administrativeRegion' in data) || (data.administrativeRegion is string && data.administrativeRegion.size() <= 240))
        && (!('coordinates' in data) || (data.coordinates is string && data.coordinates.size() <= 80))
        && (!('populationEstimate' in data) || (data.populationEstimate is string && data.populationEstimate.size() <= 160))
        && (!('relatedClans' in data) || (data.relatedClans is string && data.relatedClans.size() <= 400))
        && (!('historicalEra' in data) || (data.historicalEra is string && data.historicalEra.size() <= 160))
        && data.notableWorks is string && data.notableWorks.size() <= 400
        && (!('infoboxRows' in data) || isValidBoundedMapList(data.infoboxRows, 20))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2048))
        && (!('imageCaption' in data) || (data.imageCaption is string && data.imageCaption.size() <= 300))
        && isValidBoundedStringList(data.categories, 20)
        && (!('subcategories' in data) || isValidBoundedStringList(data.subcategories, 20))
        && (!('isStub' in data) || data.isStub is bool)
        && (!('needsSources' in data) || data.needsSources is bool)
        && (!('isFeatured' in data) || data.isFeatured is bool)
        && isValidBoundedMapList(data.sections, 40)
        && isValidBoundedMapList(data.references, 60);
    }

    function isValidArticle(data, expectedId) {
      return data.keys().hasAll([
          'id', 'name', 'subtitle', 'portal', 'summary', 'field',
          'activeYears', 'birthDeath', 'birthplace', 'notableWorks',
          'categories', 'sections', 'references', 'initials', 'accentTone',
          'updatedAt', 'protectionLevel', 'designatedApprovers', 'history',
          'createdAt', 'updatedAtServer'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'subtitle', 'portal', 'articleType', 'summary', 'field',
          'activeYears', 'birthDate', 'deathDate', 'birthDeath', 'birthplace',
          'clanAffiliation', 'geographicLocation', 'administrativeRegion',
          'coordinates', 'populationEstimate', 'relatedClans', 'historicalEra',
          'notableWorks', 'infoboxRows', 'imageUrl', 'imageCaption',
          'categories', 'subcategories', 'isStub', 'needsSources', 'isFeatured', 'sections', 'references', 'initials', 'accentTone',
          'updatedAt', 'protectionLevel', 'designatedApprovers', 'history',
          'createdAt', 'updatedAtServer'
        ])
        && isValidId(data.id)
        && data.id == expectedId
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 200
        && data.subtitle is string && data.subtitle.size() <= 300
        && isValidPortal(data.portal)
        && (!('articleType' in data) || isValidArticleType(data.articleType))
        && data.summary is string && data.summary.size() >= 5 && data.summary.size() <= 8000
        && data.field is string && data.field.size() >= 2 && data.field.size() <= 200
        && data.activeYears is string && data.activeYears.size() <= 160
        && (!('birthDate' in data) || (data.birthDate is string && data.birthDate.size() <= 80))
        && (!('deathDate' in data) || (data.deathDate is string && data.deathDate.size() <= 80))
        && data.birthDeath is string && data.birthDeath.size() <= 160
        && data.birthplace is string && data.birthplace.size() <= 240
        && (!('clanAffiliation' in data) || (data.clanAffiliation is string && data.clanAffiliation.size() <= 160))
        && (!('geographicLocation' in data) || (data.geographicLocation is string && data.geographicLocation.size() <= 300))
        && (!('administrativeRegion' in data) || (data.administrativeRegion is string && data.administrativeRegion.size() <= 240))
        && (!('coordinates' in data) || (data.coordinates is string && data.coordinates.size() <= 80))
        && (!('populationEstimate' in data) || (data.populationEstimate is string && data.populationEstimate.size() <= 160))
        && (!('relatedClans' in data) || (data.relatedClans is string && data.relatedClans.size() <= 400))
        && (!('historicalEra' in data) || (data.historicalEra is string && data.historicalEra.size() <= 160))
        && data.notableWorks is string && data.notableWorks.size() <= 400
        && (!('infoboxRows' in data) || isValidBoundedMapList(data.infoboxRows, 20))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2048))
        && (!('imageCaption' in data) || (data.imageCaption is string && data.imageCaption.size() <= 300))
        && isValidBoundedStringList(data.categories, 20)
        && (!('subcategories' in data) || isValidBoundedStringList(data.subcategories, 20))
        && (!('isStub' in data) || data.isStub is bool)
        && (!('needsSources' in data) || data.needsSources is bool)
        && (!('isFeatured' in data) || data.isFeatured is bool)
        && isValidBoundedMapList(data.sections, 40)
        && isValidBoundedMapList(data.references, 60)
        && data.initials is string && data.initials.size() >= 1 && data.initials.size() <= 16
        && isValidAccentTone(data.accentTone)
        && data.updatedAt is string && data.updatedAt.size() <= 32
        && isValidProtectionLevel(data.protectionLevel)
        && isValidBoundedStringList(data.designatedApprovers, 20)
        && isValidBoundedMapList(data.history, 100)
        && data.createdAt is timestamp
        && data.updatedAtServer is timestamp;
    }

    function isValidTalkMessage(data) {
      return data.keys().hasAll(['author', 'authorUid', 'role', 'text', 'displayTimestamp', 'createdAt'])
        && data.keys().hasOnly(['author', 'authorUid', 'role', 'topic', 'text', 'displayTimestamp', 'createdAt'])
        && data.author is string && data.author.size() >= 1 && data.author.size() <= 120
        && isValidId(data.authorUid)
        && data.role in ['visitor', 'moderator']
        && (!('topic' in data) || (data.topic is string && data.topic.size() <= 200))
        && data.text is string && data.text.size() >= 2 && data.text.size() <= 4000
        && data.displayTimestamp is string && data.displayTimestamp.size() <= 32
        && data.createdAt is timestamp;
    }

    function isValidPendingRevision(data, expectedId) {
      return data.keys().hasAll([
          'id', 'type', 'articleId', 'articleName', 'author', 'authorUid',
          'summary', 'submittedAt', 'status', 'proposedData', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'type', 'articleId', 'articleName', 'author', 'authorUid',
          'summary', 'submittedAt', 'status', 'proposedData', 'originalData',
          'rejectionReason', 'reviewedAt', 'reviewedBy',
          'accentTone', 'designatedApprovers', 'protectionLevel',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == expectedId
        && data.type in ['edit', 'new_article']
        && isValidId(data.articleId)
        && data.articleName is string && data.articleName.size() >= 2 && data.articleName.size() <= 200
        && data.author is string && data.author.size() >= 1 && data.author.size() <= 120
        && isValidId(data.authorUid)
        && data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 500
        && data.submittedAt is string && data.submittedAt.size() <= 32
        && data.status in ['pending', 'approved', 'rejected']
        && isValidProposedSnapshot(data.proposedData)
        && (!('originalData' in data) || isValidProposedSnapshot(data.originalData))
        && (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 500))
        && (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 32))
        && (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 120))
        && (!('accentTone' in data) || isValidAccentTone(data.accentTone))
        && (!('designatedApprovers' in data) || isValidBoundedStringList(data.designatedApprovers, 20))
        && (!('protectionLevel' in data) || isValidProtectionLevel(data.protectionLevel))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMemberAccount(data, expectedId) {
      return data.keys().hasAll(['id', 'name', 'roleTitle', 'specialty', 'status', 'joinedAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'roleTitle', 'specialty', 'status', 'joinedAt', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.id == expectedId
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.roleTitle is string && data.roleTitle.size() >= 2 && data.roleTitle.size() <= 100
        && data.specialty is string && data.specialty.size() >= 2 && data.specialty.size() <= 160
        && data.status in ['active', 'suspended']
        && data.joinedAt is string && data.joinedAt.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['role', 'createdAt'])
        && data.keys().hasOnly(['email', 'role', 'createdAt'])
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && data.role == 'admin'
        && data.createdAt is timestamp;
    }

    function isValidSystemSettings(data) {
      return data.keys().hasAll([
          'siteName', 'siteSubtitle', 'requireMemberApproval',
          'allowImageUrls', 'defaultProtectionLevel', 'announcementBanner', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'siteName', 'siteSubtitle', 'requireMemberApproval',
          'allowImageUrls', 'defaultProtectionLevel', 'announcementBanner', 'updatedAt'
        ])
        && data.siteName is string && data.siteName.size() >= 2 && data.siteName.size() <= 120
        && data.siteSubtitle is string && data.siteSubtitle.size() <= 300
        && data.requireMemberApproval is bool
        && data.allowImageUrls is bool
        && isValidProtectionLevel(data.defaultProtectionLevel)
        && data.announcementBanner is string && data.announcementBanner.size() <= 600
        && data.updatedAt is timestamp;
    }

    function isValidArticleMetric(data, expectedId) {
      return data.keys().hasAll([
          'articleId', 'totalViews', 'totalInteractions', 'dailyBuckets', 'lastVisitedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'articleId', 'totalViews', 'totalInteractions', 'dailyBuckets', 'lastVisitedAt', 'updatedAt'
        ])
        && isValidId(data.articleId)
        && data.articleId == expectedId
        && data.totalViews is int && data.totalViews >= 0 && data.totalViews <= 10000000
        && data.totalInteractions is int && data.totalInteractions >= 0 && data.totalInteractions <= 10000000
        && isValidBoundedMapList(data.dailyBuckets, 35)
        && data.lastVisitedAt is string && data.lastVisitedAt.size() <= 32
        && data.updatedAt is timestamp;
    }

    // ---------------- Collection Match Blocks ----------------

    // Public encyclopedia articles (zero PII)
    match /articles/{articleId} {
      allow get: if isValidId(articleId);
      allow list: if true;

      allow create: if isEmailVerified()
        && isValidId(articleId)
        && isValidArticle(incoming(), articleId)
        && incoming().createdAt == request.time
        && incoming().updatedAtServer == request.time
        && isAdmin();

      allow update: if isEmailVerified()
        && isValidId(articleId)
        && isValidArticle(incoming(), articleId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAtServer == request.time
        && (
          // Action: Publish approved content revision
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'subtitle', 'portal', 'articleType', 'summary', 'field',
            'activeYears', 'birthDate', 'deathDate', 'birthDeath', 'birthplace',
            'clanAffiliation', 'geographicLocation', 'administrativeRegion',
            'coordinates', 'populationEstimate', 'relatedClans', 'historicalEra',
            'notableWorks', 'infoboxRows', 'imageUrl', 'imageCaption', 'categories',
            'subcategories', 'isStub', 'needsSources', 'isFeatured', 'sections', 'references', 'initials', 'updatedAt', 'history', 'updatedAtServer'
          ]) ||
          // Action: Update page editorial controls & quick editorial tags (stub, needsSources, featured)
          incoming().diff(existing()).affectedKeys().hasOnly([
            'portal', 'protectionLevel', 'designatedApprovers',
            'imageUrl', 'imageCaption', 'categories', 'subcategories', 'isStub', 'needsSources', 'isFeatured', 'updatedAt', 'updatedAtServer'
          ]) ||
          // Action: Admin full-sync / JSON import / defaults reset
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'subtitle', 'portal', 'articleType', 'summary', 'field',
            'activeYears', 'birthDate', 'deathDate', 'birthDeath', 'birthplace',
            'clanAffiliation', 'geographicLocation', 'administrativeRegion',
            'coordinates', 'populationEstimate', 'relatedClans', 'historicalEra',
            'notableWorks', 'infoboxRows', 'imageUrl', 'imageCaption', 'categories',
            'subcategories', 'isStub', 'needsSources', 'isFeatured', 'sections', 'references', 'initials', 'accentTone', 'updatedAt',
            'protectionLevel', 'designatedApprovers', 'history', 'updatedAtServer'
          ])
        )
        && isAdmin();

      allow delete: if isEmailVerified() && isValidId(articleId) && isAdmin();

      // Master Gate subcollection for article discussion notes
      match /talkMessages/{messageId} {
        allow get: if isValidId(articleId) && isValidId(messageId);
        allow list: if isValidId(articleId);

        allow create: if isEmailVerified()
          && isValidId(articleId)
          && isValidId(messageId)
          && isValidTalkMessage(incoming())
          && incoming().authorUid == request.auth.uid
          && incoming().createdAt == request.time
          && (incoming().role == 'visitor' || (incoming().role == 'moderator' && isAdmin()))
          && existsAfter(/databases/$(database)/documents/articles/$(articleId));

        allow update: if isEmailVerified()
          && isValidId(articleId)
          && isValidId(messageId)
          && isValidTalkMessage(incoming())
          && incoming().authorUid == existing().authorUid
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['topic', 'text'])
          && (existing().authorUid == request.auth.uid || isAdmin())
          && exists(/databases/$(database)/documents/articles/$(articleId));

        allow delete: if isEmailVerified()
          && isValidId(articleId)
          && isValidId(messageId)
          && (existing().authorUid == request.auth.uid || isAdmin());
      }
    }

    // Member-supervised contribution queue
    match /pendingRevisions/{revisionId} {
      allow get: if isEmailVerified()
        && isValidId(revisionId)
        && (existing().authorUid == request.auth.uid || isAdmin());

      allow list: if isEmailVerified()
        && (existing().authorUid == request.auth.uid || isAdmin());

      allow create: if isEmailVerified()
        && isValidId(revisionId)
        && isValidPendingRevision(incoming(), revisionId)
        && incoming().authorUid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (incoming().type == 'new_article' || existsAfter(/databases/$(database)/documents/articles/$(incoming().articleId)));

      allow update: if isEmailVerified()
        && isValidId(revisionId)
        && existing().status == 'pending'
        && isValidPendingRevision(incoming(), revisionId)
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Approve pending revision
          (incoming().status == 'approved' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'updatedAt'])) ||
          // Action: Reject pending revision with reason
          (incoming().status == 'rejected' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'rejectionReason', 'reviewedAt', 'reviewedBy', 'updatedAt']))
        )
        && isAdmin();

      allow delete: if isEmailVerified() && isValidId(revisionId) && isAdmin();
    }

    // Audit log of reviewed revisions
    match /reviewLog/{revisionId} {
      allow get: if isEmailVerified()
        && isValidId(revisionId)
        && (existing().authorUid == request.auth.uid || isAdmin());

      allow list: if isEmailVerified()
        && (existing().authorUid == request.auth.uid || isAdmin());

      allow create: if isEmailVerified()
        && isValidId(revisionId)
        && isValidPendingRevision(incoming(), revisionId)
        && incoming().status in ['approved', 'rejected']
        && incoming().updatedAt == request.time
        && isAdmin();

      allow update, delete: if isEmailVerified() && isValidId(revisionId) && isAdmin();
    }

    // Editorial supervisor member accounts (no PII stored here)
    match /members/{memberId} {
      allow get: if isEmailVerified() && isValidId(memberId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isEmailVerified()
        && isValidId(memberId)
        && isValidMemberAccount(incoming(), memberId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();

      allow update: if isEmailVerified()
        && isValidId(memberId)
        && isValidMemberAccount(incoming(), memberId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'roleTitle', 'specialty', 'status', 'updatedAt'])
        && isAdmin();

      allow delete: if isEmailVerified() && isValidId(memberId) && isAdmin();
    }

    // Trusted Admin UID registry (PII-isolated)
    match /admins/{uid} {
      allow get: if isEmailVerified() && isValidId(uid) && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create, update: if isEmailVerified()
        && isValidId(uid)
        && isValidAdminRecord(incoming())
        && incoming().createdAt == request.time
        && isAdmin();

      allow delete: if isEmailVerified() && isValidId(uid) && isAdmin();
    }

    // Global platform settings (/settings/global — public read, admin write)
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'global';
      allow list: if false;

      allow create, update: if isEmailVerified()
        && isValidId(settingId)
        && settingId == 'global'
        && isValidSystemSettings(incoming())
        && incoming().updatedAt == request.time
        && isAdmin();

      allow delete: if false;
    }

    // Rolling 30-day article visit & engagement analytics (zero PII)
    match /articleMetrics/{articleId} {
      allow get: if isEmailVerified() && isValidId(articleId);
      allow list: if isAdmin();

      allow create: if isEmailVerified()
        && isValidId(articleId)
        && isValidArticleMetric(incoming(), articleId)
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/articles/$(articleId));

      allow update: if isEmailVerified()
        && isValidId(articleId)
        && isValidArticleMetric(incoming(), articleId)
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'totalViews', 'totalInteractions', 'dailyBuckets', 'lastVisitedAt', 'updatedAt'
        ])
        && exists(/databases/$(database)/documents/articles/$(articleId));

      allow delete: if isEmailVerified() && isValidId(articleId) && isAdmin();
    }
  }
}
